<!DOCTYPE html><html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Nail'd IT — Nail &amp; Beauty Studio a Bologna (Corticella)</title><meta name="description" content="Nail'd IT a Bologna (Corticella) — Nail &amp; Beauty Studio. Centro estetico / Nail"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet"><style>:root{--p:#E5559A;--pd:#3A1E33;--acc:#A855F7;--lacc:#F6CCE4}*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}body{font-family:'Inter',system-ui,sans-serif;color:#15181d;-webkit-font-smoothing:antialiased;line-height:1.6}img{display:block;max-width:100%}a{text-decoration:none;color:inherit}.wrap{max-width:1160px;margin:0 auto;padding:0 24px}.disp{font-family:var(--disp)}svg{width:1em;height:1em}.reveal{opacity:0;transform:translateY(22px);transition:.7s cubic-bezier(.2,.7,.2,1)}.reveal.in{opacity:1;transform:none}.callbar{display:none}@media(max-width:560px){.callbar{display:flex;position:fixed;left:10px;right:10px;bottom:10px;z-index:80;gap:8px}.callbar .cb{flex:1;display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:14px;border-radius:14px;font-weight:700;box-shadow:0 12px 30px -8px rgba(0,0,0,.45)}.callbar .cb svg{width:18px;height:18px}.cb.solid{background:var(--p);color:#fff}.cb.ghost{background:#fff;color:#15181d;border:1px solid #e6e8ec}body{padding-bottom:74px}}body{background:#fbfaff;color:#211f2b}.aurora{position:fixed;inset:0;z-index:-1;overflow:hidden}.aurora:before,.aurora:after{content:'';position:absolute;width:60vw;height:60vw;border-radius:50%;filter:blur(90px);opacity:.5}.aurora:before{background:var(--p);top:-15vw;right:-10vw}.aurora:after{background:var(--acc);bottom:-20vw;left:-10vw}.site-head{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.6);backdrop-filter:blur(16px);border-bottom:1px solid rgba(0,0,0,.05)}.nav{display:flex;align-items:center;justify-content:space-between;height:72px}.brand{display:flex;gap:11px;align-items:center;font-family:var(--disp);font-weight:700;font-size:1.2rem}.brand .bm{width:40px;height:40px;border-radius:14px;background:linear-gradient(135deg,var(--p),var(--acc));color:#fff;display:grid;place-items:center;font-weight:700;font-size:.9rem}.nav-links{display:flex;gap:26px}.nav-links a{color:#6a6579;font-size:.93rem}.nav-links a:hover{color:#211f2b}.navcta{background:var(--p);color:#fff;padding:11px 20px;border-radius:999px;font-weight:600;font-size:.9rem;display:inline-flex;gap:7px;align-items:center;box-shadow:0 10px 24px -10px var(--p)}.navcta svg{width:16px;height:16px}.hero{padding:64px 0 30px}.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:46px;align-items:center}.eyebrow{display:inline-flex;gap:8px;align-items:center;background:rgba(255,255,255,.7);border:1px solid rgba(0,0,0,.06);padding:7px 15px;border-radius:999px;font-size:.8rem;font-weight:600;color:var(--p)}.hero h1{font-family:var(--disp);font-weight:700;font-size:clamp(2.5rem,5.4vw,4.1rem);line-height:1.05;margin:20px 0 18px}.hero .lead{color:#6a6579;font-size:1.15rem;max-width:40ch;margin-bottom:26px}.cta-row{display:flex;gap:13px;flex-wrap:wrap}.btnp{display:inline-flex;gap:9px;align-items:center;background:var(--p);color:#fff;padding:15px 28px;border-radius:999px;font-weight:600;box-shadow:0 14px 30px -12px var(--p);transition:.2s}.btnp:hover{transform:translateY(-2px)}.btnp svg{width:18px;height:18px}.btng{display:inline-flex;gap:9px;align-items:center;background:rgba(255,255,255,.8);border:1px solid rgba(0,0,0,.08);color:#211f2b;padding:15px 26px;border-radius:999px;font-weight:600}.btng svg{width:17px;height:17px}.hbadges{display:flex;gap:12px;margin-top:24px;flex-wrap:wrap}.chip{display:inline-flex;gap:8px;align-items:center;background:rgba(255,255,255,.8);border:1px solid rgba(0,0,0,.06);padding:8px 15px;border-radius:999px;font-weight:600;font-size:.86rem}.chip svg{width:15px;height:15px;color:var(--p)}.cstars svg{width:14px;height:14px;color:var(--acc)}.hero-photo{position:relative}.hero-photo .frame{border-radius:30px;overflow:hidden;aspect-ratio:1;box-shadow:0 40px 80px -30px rgba(60,40,90,.5);border:6px solid rgba(255,255,255,.7)}.hero-photo img{width:100%;height:100%;object-fit:cover}.hero-photo.noimg .frame{background:linear-gradient(150deg,var(--p),var(--acc));display:grid;place-items:center}.hero-photo.noimg svg{width:42%;height:42%;color:rgba(255,255,255,.9)}.floatpill{position:absolute;left:-14px;bottom:26px;background:rgba(255,255,255,.9);backdrop-filter:blur(8px);border-radius:18px;padding:12px 16px;display:flex;gap:10px;align-items:center;box-shadow:0 20px 40px -18px rgba(60,40,90,.5)}.floatpill svg{width:28px;height:28px;color:var(--p)}.floatpill b{display:block;font-size:.95rem}.floatpill span{font-size:.78rem;color:#6a6579}.section{padding:90px 0}.sec-head{text-align:center;max-width:620px;margin:0 auto 50px}.sec-head .eyebrow{margin:0 auto}.sec-head h2{font-family:var(--disp);font-weight:700;font-size:clamp(1.9rem,4vw,2.8rem);margin-top:12px}.sec-head p{color:#6a6579;margin-top:8px}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.card{background:rgba(255,255,255,.7);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.6);border-radius:24px;padding:28px 24px;box-shadow:0 20px 44px -30px rgba(60,40,90,.4);transition:.25s}.card:hover{transform:translateY(-6px)}.cardico{display:grid;place-items:center;width:52px;height:52px;border-radius:16px;background:linear-gradient(135deg,var(--p),var(--acc));color:#fff;margin-bottom:16px}.cardico svg{width:24px;height:24px}.card h3{font-size:1.08rem;margin-bottom:7px}.card p{color:#6a6579;font-size:.94rem}.feats{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.feat{background:rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.6);border-radius:22px;padding:26px;display:block}.featico{display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:var(--lacc);color:var(--pd);margin-bottom:14px}.featico svg{width:23px;height:23px}.feat h3{font-size:1.1rem;margin-bottom:6px}.feat p{color:#6a6579;font-size:.94rem}.gal{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.gal figure{margin:0;border-radius:20px;overflow:hidden;aspect-ratio:1;box-shadow:0 18px 40px -26px rgba(60,40,90,.5)}.gal img{width:100%;height:100%;object-fit:cover;transition:.4s}.gal figure:hover img{transform:scale(1.05)}.review{text-align:center}.review .rstars{display:inline-flex;gap:3px;color:var(--acc);margin-bottom:14px}.review .rstars svg{width:22px;height:22px}.review blockquote{font-family:var(--disp);font-weight:700;font-size:clamp(1.5rem,3.6vw,2.3rem);max-width:800px;margin:0 auto 14px;background:linear-gradient(120deg,var(--p),var(--pd));-webkit-background-clip:text;background-clip:text;color:transparent;line-height:1.3}.review .src{color:#6a6579}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}.crow{display:flex;gap:15px;padding:18px 0;border-bottom:1px solid rgba(0,0,0,.06)}.crow:last-child{border:0}.crow svg{width:24px;height:24px;color:var(--p);flex:none}.cl{font-size:.74rem;text-transform:uppercase;letter-spacing:.08em;color:#9a94a6}.cv{display:block;font-weight:600;font-size:1.04rem}a.cv:hover{color:var(--p)}.mapbtn{display:flex;flex-direction:column;justify-content:flex-end;min-height:300px;border-radius:24px;padding:26px;background:linear-gradient(150deg,var(--lacc),rgba(255,255,255,.6));border:1px solid rgba(255,255,255,.7);position:relative;overflow:hidden;box-shadow:0 20px 44px -30px rgba(60,40,90,.4)}.mapbtn b{font-size:1.1rem;position:relative}.mapbtn span{color:#6a6579;position:relative}.mapbtn .go{margin-top:16px;align-self:flex-start;background:var(--p);color:#fff;padding:12px 24px;border-radius:999px;font-weight:600;position:relative}.ctaband{max-width:960px;margin:0 auto;text-align:center;padding:60px 30px;background:linear-gradient(135deg,var(--p),var(--acc));border-radius:32px;color:#fff;box-shadow:0 40px 80px -40px var(--p)}.ctaband h2{font-family:var(--disp);font-size:clamp(1.8rem,4vw,2.7rem);margin-bottom:12px}.ctaband p{opacity:.9;max-width:520px;margin:0 auto 24px}.ctaband .cta-row{justify-content:center}.ctaband .btnp{background:#fff;color:var(--pd)}.ctaband .btng{background:rgba(255,255,255,.15);border-color:rgba(255,255,255,.4);color:#fff}footer{padding:44px 0 30px;color:#8a8496}.fgrid{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;align-items:center}.fbrand{display:flex;gap:11px;align-items:center;font-family:var(--disp);font-weight:700}.fmark{width:32px;height:32px;border-radius:11px;background:linear-gradient(135deg,var(--p),var(--acc));color:#fff;display:grid;place-items:center;font-weight:700;font-size:.8rem}.fnote{margin-top:20px;font-size:.78rem}@media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:36px}.hero-photo{order:-1;max-width:400px;margin:0 auto}.cards{grid-template-columns:repeat(2,1fr)}.feats{grid-template-columns:1fr}.contact-grid{grid-template-columns:1fr}.gal{grid-template-columns:repeat(2,1fr)}.nav-links{display:none}.section{padding:66px 0}}@media(max-width:560px){.cards{grid-template-columns:1fr}}</style></head><body id="top"><header class="site-head"><div class="wrap nav"><a class="brand" href="#top"><span class="bm">NI</span>Nail'd IT</a><nav class="nav-links"><a href="#servizi">Servizi</a><a href="#perche">Perché noi</a><a href="#galleria">Galleria</a><a href="#contatti">Contatti</a></nav><a class="navcta" href="tel:3762370301"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 4h4l2 5-2.5 1.5a12 12 0 0 0 6 6L15 14l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 2 6a2 2 0 0 1 2-2Z" stroke-linejoin="round"/></svg>Prenota</a></div></header><div class="aurora"></div><section class="hero"><div class="wrap hero-grid"><div><span class="eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l1.9 4.6L18.5 9l-4.6 1.9L12 15.5l-1.9-4.6L5.5 9l4.6-1.4L12 3ZM19 14l.9 2.1 2.1.9-2.1.9L19 20l-.9-2.1-2.1-.9 2.1-.9L19 14Z" stroke-linejoin="round"/></svg> Nail &amp; Beauty Studio</span><h1>Unghie curate, dettagli che fanno la differenza</h1><p class="lead">Ricostruzione, semipermanente e nail art a Bologna (Corticella). Mani e piedi perfetti, in un ambiente curato e rilassante.</p><div class="cta-row"><a class="btnp" href="tel:3762370301"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 4h4l2 5-2.5 1.5a12 12 0 0 0 6 6L15 14l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 2 6a2 2 0 0 1 2-2Z" stroke-linejoin="round"/></svg><span>Prenota</span></a><a class="btng" href="https://wa.me/393762370301" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 4h4l2 5-2.5 1.5a12 12 0 0 0 6 6L15 14l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 2 6a2 2 0 0 1 2-2Z" stroke-linejoin="round"/></svg><span>WhatsApp</span></a></div><div class="hbadges"><span class="chip"><span class="cstars"><svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1"><path d="M12 3l2.6 5.9 6.4.6-4.8 4.3 1.4 6.2L12 17.8 6.4 20l1.4-6.2L3 9.5l6.4-.6L12 3Z"/></svg></span>4,6 su Google</span><span class="chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.5"/></svg> Bologna (Corticella)</span></div></div><div class="hero-photo"><div class="frame"><img src="https://lh3.googleusercontent.com/gps-cs-s/AHRPTWl7lixDieCz9yW-K4dbTKby9-op_Z7SYbhF7-CYw2mEAmbyJs_V_CY3Ieu4MsfWnuI0-GjQZhFEP27kcioTui-Y3bVIbo91-4cTJZg73vSfZPqSyD8Wdz2hvgWgkkkGpzfslkddFrf-vIg=w1280-h960-k-no" alt="Nail'd IT" loading="eager"></div><div class="floatpill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l2.6 5.9 6.4.6-4.8 4.3 1.4 6.2L12 17.8 6.4 20l1.4-6.2L3 9.5l6.4-.6L12 3Z" stroke-linejoin="round"/></svg><div><b>4,6 ★</b><span>su Google</span></div></div></div></div></section><section class="section services" id="servizi"><div class="wrap"><div class="sec-head reveal"><span class="eyebrow">I nostri servizi</span><h2 class="disp">Cosa possiamo fare per te</h2><p>Servizi pensati per prenderci cura di te, con professionalità.</p></div><div class="cards"><div class="card reveal"><span class="cardico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 11V6a2 2 0 0 1 4 0v5M11 11V4a2 2 0 0 1 4 0v7M15 11V6a2 2 0 0 1 4 0v9a6 6 0 0 1-6 6h-2a6 6 0 0 1-5.3-3.2L4 15" stroke-linecap="round" stroke-linejoin="round"/></svg></span><h3>Ricostruzione unghie</h3><p>Gel e acrilico per unghie resistenti e naturali.</p></div><div class="card reveal"><span class="cardico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l1.9 4.6L18.5 9l-4.6 1.9L12 15.5l-1.9-4.6L5.5 9l4.6-1.4L12 3ZM19 14l.9 2.1 2.1.9-2.1.9L19 20l-.9-2.1-2.1-.9 2.1-.9L19 14Z" stroke-linejoin="round"/></svg></span><h3>Semipermanente</h3><p>Colore brillante e a lunga durata.</p></div><div class="card reveal"><span class="cardico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9.5 14.5 3 21M14 4l6 6M17 7 7.5 16.5a3.5 3.5 0 0 1-5 0 3.5 3.5 0 0 1 0-5L12 2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><h3>Nail art</h3><p>Decori e design personalizzati per ogni occasione.</p></div><div class="card reveal"><span class="cardico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 2.7 6.3 9a8 8 0 1 0 11.4 0L12 2.7Z" stroke-linejoin="round"/></svg></span><h3>Manicure &amp; pedicure</h3><p>Trattamenti completi per mani e piedi.</p></div></div></div></section><section class="section why" id="perche"><div class="wrap"><div class="sec-head reveal"><span class="eyebrow">Perché sceglierci</span><h2 class="disp">La differenza è nei dettagli</h2><p>Piccole attenzioni che rendono grande ogni esperienza.</p></div><div class="feats"><div class="feat reveal"><span class="featico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></span><div><h3>Igiene certosina</h3><p>Strumenti sterilizzati e attenzione ai dettagli.</p></div></div><div class="feat reveal"><span class="featico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z" stroke-linejoin="round"/></svg></span><div><h3>Stile personalizzato</h3><p>Progettiamo il look perfetto per te.</p></div></div><div class="feat reveal"><span class="featico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2" stroke-linecap="round"/></svg></span><div><h3>Su appuntamento</h3><p>Il tuo tempo, dedicato solo a te.</p></div></div></div></div></section><section class="section galwrap" id="galleria"><div class="wrap"><div class="sec-head reveal"><span class="eyebrow">Galleria</span><h2 class="disp">La nostra nail art</h2></div><div class="gal"><figure><img src="https://lh3.googleusercontent.com/gps-cs-s/AHRPTWl7Z-I1YaLeWU-LGS-xt4h7Wudy4Is5PpVJO26XDdDhXQKNTZTfqAYjkRtBZxcRhHzANS2dnCbtqTNyQYe6HsBPVWa8fijtwWSNGq5kb13i0nVw-2NpEF8zr3s_ULKNiUuNeyvdDFCngCOK=w1280-h960-k-no" alt="Nail'd IT foto 1" loading="lazy"></figure><figure><img src="https://lh3.googleusercontent.com/gps-